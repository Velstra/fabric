### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# JetBrains IDE
/.idea/

# Claude Code local settings (never publish)

# Generated test PKI (scripts/gen-certs.sh)
*.pem
*.key
*.crt

# …except the committed REST-gateway TLS test fixtures: a throwaway EC test PKI
# (CA + a localhost server cert/key), not real secrets, that the controller's
# HTTPS integration test and the rest_tls unit tests load by path.
!velstra-controller/tests/fixtures/*.pem
!velstra-controller/tests/fixtures/*.key
